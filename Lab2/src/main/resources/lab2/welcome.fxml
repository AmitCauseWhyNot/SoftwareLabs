<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER" spacing="14" prefWidth="460" prefHeight="380"
      style="-fx-padding: 28; -fx-background-color: white; -fx-font-family: 'Segoe UI';">
    <Label fx:id="welcomeMessage" text="Welcome!"
           style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #17324d;"/>
    <Label text="You are logged in to GCM." style="-fx-font-size: 15;"/>
</VBox>
